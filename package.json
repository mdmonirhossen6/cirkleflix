{
  "name": "cirkleflix",
  "version": "1.0.0",
  "description": "CirkleFlix – a Netflix-style local website for the Circle FTP (BDIX) media server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "serve": "node server/index.js",
    "start": "vite build && node server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
